{
  "manifest_version": 3,
  "name": "화면 도둑",
  "version": "0.5.0",
  "description": "Alt+S hides the current tab and jumps to Slack. Alt+A blurs the page except around the cursor.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Hide current tab / bring hidden tab back"
    },
    "spotlight": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Blur page except around the cursor"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "화면 도둑 (Alt+S)"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "spotlight.js"
      ],
      "run_at": "document_start"
    }
  ]
}
