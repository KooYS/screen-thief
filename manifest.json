{
  "manifest_version": 3,
  "name": "화면 도둑",
  "version": "0.1.0",
  "description": "Alt+S turns the current page into a Slack channel view.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "words.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
